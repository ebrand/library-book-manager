{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": false,
    "types": ["vitest/globals", "@testing-library/jest-dom", "node"],
    "paths": {
      "@platform-standin/*": ["./platform-standin/*"]
    }
  },
  "include": ["src", "platform-standin", "tests", "vite.config.ts"]
}
